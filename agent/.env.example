# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=switchboard-receptionist
LIVEKIT_SIP_SUBDOMAIN=
LIVEKIT_SIP_NUMBER=
LIVEKIT_SIP_OUTBOUND_TRUNK=

# Go API and agent bootstrap
GO_API_URL=http://127.0.0.1:8090
AGENT_API_KEY=
AGENT_TOKEN_SECRET=
# Allows LiveKit Agent Console sessions without the Go token endpoint.
ALLOW_DEV_TENANT=false
DEV_TENANT=rivera

# Models (plugins use your own keys; ElevenLabs is retired from LiveKit Inference)
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-nano
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal
ELEVEN_API_KEY=
ELEVEN_VOICE_ID=
ELEVEN_MODEL=eleven_turbo_v2_5
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3

# Recording: only started after explicit consent, written to India storage.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=ap-south-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_FORCE_PATH_STYLE=false

# Latency tuning
PREEMPTIVE_GENERATION=true
ENDPOINTING_MIN_DELAY=0.35
ENDPOINTING_MAX_DELAY=2.0
