{
  "title": "Switchboard",
  "uid": "switchboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Active calls",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "switchboard_active_calls", "legendFormat": "active" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Calls and escalations (per interval)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(switchboard_calls_total[$__rate_interval])",
          "legendFormat": "calls"
        },
        {
          "refId": "B",
          "expr": "increase(switchboard_escalations_total[$__rate_interval])",
          "legendFormat": "escalations"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 turn latency (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(switchboard_turn_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 per stage (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(switchboard_stage_latency_seconds_bucket[5m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI cache hit rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind) (rate(switchboard_ai_cache_hits_total[5m])) / (sum by (kind) (rate(switchboard_ai_cache_hits_total[5m])) + sum by (kind) (rate(switchboard_ai_cache_misses_total[5m])))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "AI answer p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(switchboard_ai_answer_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Bookings (1h)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(switchboard_bookings_total[1h]))",
          "legendFormat": "booked"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 first audio (s)",
      "gridPos": { "h": 6, "w": 10, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(switchboard_stage_latency_seconds_bucket{stage=\"first_audio\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM tokens / min",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum(rate(switchboard_llm_prompt_tokens_total[5m]))",
          "legendFormat": "prompt"
        },
        {
          "refId": "B",
          "expr": "60 * sum(rate(switchboard_llm_completion_tokens_total[5m]))",
          "legendFormat": "completion"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "TTS characters / min",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (provider) (rate(switchboard_tts_characters_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "STT audio / min (s)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 30 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "60 * sum by (provider) (rate(switchboard_stt_seconds_total[5m]))",
          "legendFormat": "{{provider}}"
        }
      ]
    }
  ]
}
