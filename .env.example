# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL=12h
# Only these peers may set X-Forwarded-For.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# ---------------------------------------------------------------------------
# Accounts and sessions
# ---------------------------------------------------------------------------
# postgres (default when DATABASE_URL is set) or sqlite for local fallback.
AUTH_DRIVER=postgres
AUTH_DB=data/auth.db
AUTH_DISABLED=false
# Only honoured when APP_ENV=development.
ALLOW_DEV_AUTH=false
DEV_TENANT=rivera

# ---------------------------------------------------------------------------
# PostgreSQL: bookings, staff, calls, turns, labels, recording metadata, usage,
# accounts, and sessions.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://switchboard:switchboard@127.0.0.1:5432/switchboard?sslmode=disable

# Optional. Required for distributed call/login limits across Go instances.
REDIS_URL=

# ---------------------------------------------------------------------------
# Transactional email: invites, verification, password reset.
# Leave empty in development; links are logged and returned by the API.
# Required when APP_ENV=production.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@switchboard.local

# ---------------------------------------------------------------------------
# LiveKit Cloud
# ---------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=switchboard-receptionist
LIVEKIT_SIP_SUBDOMAIN=
LIVEKIT_SIP_NUMBER=
LIVEKIT_SIP_OUTBOUND_TRUNK=

# ---------------------------------------------------------------------------
# Python agent worker
# ---------------------------------------------------------------------------
GO_API_URL=http://127.0.0.1:8090
AGENT_API_KEY=
AGENT_TOKEN_SECRET=
AGENT_VERSION=
# Lets the LiveKit Agent Console start a session without the token endpoint.
ALLOW_DEV_TENANT=false
LOG_LEVEL=INFO
MAX_CALL_SECONDS=900
TRANSCRIPT_DEBUG=false
PREEMPTIVE_GENERATION=true
ENDPOINTING_MIN_DELAY=0.35
ENDPOINTING_MAX_DELAY=2.0

# Default stack
DEEPGRAM_API_KEY=
STT_MODEL=nova-3
STT_FALLBACK_MODEL=nova-2-phonecall
STT_LANGUAGE=en-IN
STT_ENDPOINTING_MS=200
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_THINKING_BUDGET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-nano
CARTESIA_API_KEY=
CARTESIA_MODEL=sonic-3
CARTESIA_VOICE_ID=
ELEVEN_API_KEY=
ELEVEN_MODEL=eleven_turbo_v2_5
ELEVEN_VOICE_ID=

# Sarvam stack, selectable per browser call
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# ---------------------------------------------------------------------------
# Inference service: RAG, embeddings, and vision
# ---------------------------------------------------------------------------
INFERENCE_URL=http://127.0.0.1:8100
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
EMBED_MODEL=nomic-embed-text
VISION_MODEL=qwen2.5vl:3b
KNOWLEDGE_DIR=data/knowledge

# ---------------------------------------------------------------------------
# Telephony
# ---------------------------------------------------------------------------
TELEPHONY_PROVIDER=plivo
PLIVO_SIP_DOMAIN=
PLIVO_USERNAME=
PLIVO_PASSWORD=
PLIVO_DEFAULT_NUMBER=
MANAGER_NUMBER=

# ---------------------------------------------------------------------------
# Recording and retention
# ---------------------------------------------------------------------------
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=ap-south-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_FORCE_PATH_STYLE=false
RECORDING_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=180

# ---------------------------------------------------------------------------
# Cost controls
# ---------------------------------------------------------------------------
PRICING_FILE=config/pricing.json
DEFAULT_MONTHLY_CAP_MINOR=0
BUDGET_ACTION=transfer

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8090
NEXT_PUBLIC_AI_URL=http://127.0.0.1:8100
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_DISABLED=false
