# Conversational agent (Brain)
# Auto: OpenAI if OPENAI_API_KEY is set. Otherwise BRAIN=hybrid runs the
# deterministic slot state machine and uses Ollama only to phrase the reply.
# BRAIN=llm forces the experimental tool-calling brain.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
BRAIN=hybrid

# Local models / RAG
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b

# AI service
INFERENCE_URL=http://localhost:8100
# STT/TTS providers: sarvam, deepgram, local (piper for TTS)
STT_PROVIDER=sarvam
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
TTS_PROVIDER=sarvam
# base is fast on CPU; small.en is more accurate but noticeably slower
WHISPER_MODEL=base
# A Piper medium voice at 22.05 kHz sounds far better than the low voices
PIPER_VOICE=/absolute/path/to/en_US-lessac-medium.onnx
TTS_RATE=22050
KNOWLEDGE_DIR=data/knowledge

# Optional
SUPERVISOR_TOKEN=
OTEL_EXPORTER_OTLP_ENDPOINT=
CHAT_MODEL_LARGE=

# Public site URL for canonical and social metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
