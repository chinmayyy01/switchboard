# Conversational agent (Brain)
# Auto: Sarvam if SARVAM_API_KEY is set, then OpenAI if OPENAI_API_KEY is set.
# Otherwise BRAIN=hybrid runs the deterministic slot state machine and uses
# Ollama only to phrase the reply. BRAIN=llm forces the experimental brain.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_THINKING_LEVEL=minimal
OPENAI_MODEL=gpt-4o-mini
BRAIN=hybrid

# Local models / RAG
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
VISION_MODEL=qwen2.5vl:3b

# AI service
INFERENCE_URL=http://127.0.0.1:8100
# STT: sarvam, deepgram, local. TTS: sarvam, piper.
STT_PROVIDER=sarvam
DEEPGRAM_API_KEY=
# Voice input tuning. en-IN is noticeably better for Indian callers than en-US.
STT_MODEL=nova-3
STT_FALLBACK_MODEL=nova-2-phonecall
STT_LANGUAGE=en-IN
STT_ENDPOINTING_MS=200
DEEPGRAM_MODEL=nova-3
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
TTS_PROVIDER=sarvam
# base is fast on CPU; small.en is more accurate but noticeably slower
WHISPER_MODEL=base
# A Piper medium voice at 22.05 kHz sounds far better than the low voices
PIPER_VOICE=/absolute/path/to/en_US-lessac-medium.onnx
TTS_RATE=22050
KNOWLEDGE_DIR=data/knowledge

# Accounts and sessions
AUTH_DB=data/auth.db
AUTH_DISABLED=false
DEV_TENANT=rivera
NEXT_PUBLIC_AUTH_DISABLED=false
APP_ENV=development
APP_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL=12h
COOKIE_SECURE=false

# Durable bookings and staff schedules (PostgreSQL)
DATABASE_URL=postgres://switchboard:switchboard@127.0.0.1:5432/switchboard?sslmode=disable

# LiveKit Cloud + agent bridge
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=switchboard-receptionist
LIVEKIT_SIP_SUBDOMAIN=
LIVEKIT_SIP_NUMBER=
LIVEKIT_SIP_OUTBOUND_TRUNK=
AGENT_API_KEY=
AGENT_TOKEN_SECRET=

# Telephony provider. Plivo is primary; Exotel is a stub until routing,
# trial limits, KYC, and SIP REFER support are confirmed.
TELEPHONY_PROVIDER=plivo
PLIVO_SIP_DOMAIN=
PLIVO_USERNAME=
PLIVO_PASSWORD=
PLIVO_DEFAULT_NUMBER=

# Warm-transfer target (kept out of tenant files; use MANAGER_NUMBER_<TENANT>
# for a tenant-specific override).
MANAGER_NUMBER=

# Agent recordings are written to your own India-region bucket, after consent.
RECORDING_S3_BUCKET=
RECORDING_S3_REGION=ap-south-1
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=
RECORDING_S3_FORCE_PATH_STYLE=false

# Optional
OTEL_EXPORTER_OTLP_ENDPOINT=
CHAT_MODEL_LARGE=

# Public site URL for canonical and social metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_AI_URL=http://127.0.0.1:8100
